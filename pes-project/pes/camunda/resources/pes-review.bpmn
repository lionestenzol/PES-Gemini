<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="pes_review_definitions" targetNamespace="https://pes.local/bpmn" exporter="PES" exporterVersion="1.0.0">
  <bpmn:process id="pes-review" name="PES scheduled reviews" isExecutable="true">
    <bpmn:extensionElements><zeebe:versionTag value="1.0.0" /></bpmn:extensionElements>
    <bpmn:startEvent id="eod_timer_start" name="End-of-day timer"><bpmn:outgoing>eod_flow_task</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle>R/P1D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:userTask id="eod_review_task" name="Complete end-of-day review"><bpmn:extensionElements><zeebe:formDefinition formId="pes-review" bindingType="deployment"/><zeebe:assignmentDefinition candidateGroups="pes-reviewers"/><zeebe:taskListeners><zeebe:taskListener eventType="completing" type="pes-audit-user-task" retries="3"/></zeebe:taskListeners><zeebe:ioMapping><zeebe:input source="=&quot;end-of-day&quot;" target="review_type"/></zeebe:ioMapping><zeebe:userTask/></bpmn:extensionElements><bpmn:incoming>eod_flow_task</bpmn:incoming><bpmn:outgoing>eod_flow_record</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="record_eod_review" name="Record end-of-day review"><bpmn:extensionElements><zeebe:taskDefinition type="pes-record-review" retries="5"/></bpmn:extensionElements><bpmn:incoming>eod_flow_record</bpmn:incoming><bpmn:outgoing>eod_flow_end</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="eod_review_end" name="End-of-day review recorded"><bpmn:incoming>eod_flow_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="weekly_timer_start" name="Weekly timer"><bpmn:outgoing>weekly_flow_task</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle>R/P7D</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent>
    <bpmn:userTask id="weekly_review_task" name="Complete weekly review"><bpmn:extensionElements><zeebe:formDefinition formId="pes-review" bindingType="deployment"/><zeebe:assignmentDefinition candidateGroups="pes-reviewers"/><zeebe:taskListeners><zeebe:taskListener eventType="completing" type="pes-audit-user-task" retries="3"/></zeebe:taskListeners><zeebe:ioMapping><zeebe:input source="=&quot;weekly&quot;" target="review_type"/></zeebe:ioMapping><zeebe:userTask/></bpmn:extensionElements><bpmn:incoming>weekly_flow_task</bpmn:incoming><bpmn:outgoing>weekly_flow_record</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="record_weekly_review" name="Record weekly review"><bpmn:extensionElements><zeebe:taskDefinition type="pes-record-review" retries="5"/></bpmn:extensionElements><bpmn:incoming>weekly_flow_record</bpmn:incoming><bpmn:outgoing>weekly_flow_end</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="weekly_review_end" name="Weekly review recorded"><bpmn:incoming>weekly_flow_end</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="eod_flow_task" sourceRef="eod_timer_start" targetRef="eod_review_task"/><bpmn:sequenceFlow id="eod_flow_record" sourceRef="eod_review_task" targetRef="record_eod_review"/><bpmn:sequenceFlow id="eod_flow_end" sourceRef="record_eod_review" targetRef="eod_review_end"/>
    <bpmn:sequenceFlow id="weekly_flow_task" sourceRef="weekly_timer_start" targetRef="weekly_review_task"/><bpmn:sequenceFlow id="weekly_flow_record" sourceRef="weekly_review_task" targetRef="record_weekly_review"/><bpmn:sequenceFlow id="weekly_flow_end" sourceRef="record_weekly_review" targetRef="weekly_review_end"/>
  </bpmn:process>
</bpmn:definitions>
